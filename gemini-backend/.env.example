# Copy to .env locally, or configure as deployment secrets. Never commit .env.
GEMINI_API_KEY=
# Generate with: openssl rand -hex 32
APP_ACCESS_TOKEN=
PORT=8787
GEMINI_MODEL=gemini-3.6-flash
# Add your exact deployed app origin(s), comma separated. Keep only origins you own.
ALLOWED_ORIGINS=null,https://localhost,capacitor://localhost
PER_IP_DAILY_LIMIT=12
GLOBAL_DAILY_LIMIT=50
